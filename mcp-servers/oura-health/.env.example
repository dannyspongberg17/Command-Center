# Copy to .env for local development:   cp .env.example .env
# .env is git-ignored. NEVER commit real values.
# Generate the three random secrets with:   npm run gen-secrets

# --- Where the server runs ---------------------------------------------------
NODE_ENV=development
HOST=127.0.0.1
PORT=8080
# The URL people (and Oura) use to reach this server.
# Local: http://localhost:8080      Production: https://<your-app>.fly.dev
PUBLIC_BASE_URL=http://localhost:8080

# --- Your Oura developer application -----------------------------------------
# From https://cloud.ouraring.com/oauth/applications
# Its Redirect URI must be exactly:  <PUBLIC_BASE_URL>/oauth/callback
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
# Space-separated scopes to request. Must match what your Oura app allows.
OURA_SCOPES=personal daily heartrate

# --- Secrets protecting this server (use `npm run gen-secrets`) --------------
# Bearer token Claude sends to /mcp. Comma-separate several to rotate.
MCP_AUTH_TOKENS=
# Password for /oauth/start and /oauth/status (browser login, any username).
ADMIN_PASSWORD=
# 32-byte base64 key that encrypts Oura tokens on disk. Losing it = reconnect.
TOKEN_ENCRYPTION_KEY=

# --- Storage -----------------------------------------------------------------
DATA_DIR=./data
TRUST_PROXY=false
