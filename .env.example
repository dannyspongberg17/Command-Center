# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection string. For local dev, run a local Postgres or use
# `npx prisma dev`. For production, create a free database at https://neon.com
# (or Vercel Postgres / Supabase) and paste its connection string here.
DATABASE_URL="postgresql://user:password@localhost:5432/command_center?schema=public"

# Session encryption secret for NextAuth. Generate one with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=""

# The canonical URL this app is served from.
# Local dev: http://localhost:3000
# Production: your deployed URL, e.g. https://command-center.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# Anthropic API key, used by the Investment Agent to generate portfolio
# insights. Create one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# Credentials for the single dashboard user, used only by `npm run db:seed`
# to create the account. Change ADMIN_PASSWORD to something strong before
# seeding — it is hashed into the database and this plaintext value is not
# needed again afterward.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD=""

# Plaid credentials, used by the Investment Agent's "Connect account" flow
# to link real brokerage/bank accounts. Get these from your Plaid Dashboard
# (dashboard.plaid.com) under Team Settings -> Keys. PLAID_ENV must match
# which secret you're using: "sandbox" (fake test data) or "production"
# (real accounts — what Trial/Production keys use).
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="sandbox"

# Encrypts Plaid access tokens at rest before they're stored in the database
# — never store them in plaintext. Generate one with:
#   openssl rand -base64 32
ENCRYPTION_KEY=""
